MODE=dev # local || dev || prod
DUCATUSCORE_CONFIG_PATH=~/ducatuscore.config
NODE_WHITE_LIST=::ffff:127.0.0.1,::1,::ffff:176.223.136.183,::ffff:89.40.9.174,::ffff:144.76.34.104
FCM_KEY=
SOCKET_API_KEY=
DWS_KEYS=
DISABLED_RATE_LIMITER=true

# Dev environments
DUC_NODE_PROTOCOL=https
DUCX_NODE_PROTOCOL=https
DUCX_WS_NODE_PROTOCOL=wss
DUC_WS_NODE_PROTOCOL=wss
DUC_NODE_URL=localhost:3000
DUCX_NODE_URL=localhost:3000
DB_HOST=localhost
DWS_DB_HOST=localhost
DWS_DB_PORT=27017

# Docker: host directories with the MongoDB data (default ./.data/node_db and ./.data/dws_db)
NODE_DB_VOLUME=/mnt/node/data/node_db
DWS_DB_VOLUME=/data/dws_db

# Docker: host ports published on 127.0.0.1 (defaults below). Inside the containers the apps listen on
# APP_PORT=3000, fixed in docker-compose.yml
NODE_PORT=3001
DWS_PORT=3233

# BSC history indexer (MegaNode), https://nodereal.io
# One key, or several comma-separated keys in NODEREAL_API_KEYS (used in turn, one per request; takes precedence)
NODEREAL_API_KEY=
NODEREAL_API_KEYS=

# Debug
DEBUG_TXHISTORY=false
